"""Ekstraksi foto -> landmark MediaPipe. Resume memeriksa ukuran + waktu modifikasi file."""
import argparse
import re
import time
import urllib.request
from pathlib import Path

import numpy as np

URL = "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task"
EXT = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}
VER = 3  # v3: koordinat piksel + fingerprint file + daftar seluruh kelas


def numeric_id(path: Path):
    """Ambil angka di ujung nama file (mis. IMG_0001); nama lain dikembalikan None."""
    m = re.search(r"(\d+)$", path.stem)
    return int(m.group(1)) if m else None


def group_for(path: Path, class_name: str, block_size: int, first_number):
    """Heuristik, BUKAN deteksi sesi sebenarnya: blok nomor berurutan per kelas."""
    number = numeric_id(path)
    if number is not None and first_number is not None:
        return f"{class_name}:{(number - first_number) // block_size}"
    return f"{class_name}:name:{path.stem}"


def save(out, files, sizes, mtimes, Ls, ns, cls, groups, class_names):
    out = Path(out).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = Path(str(out) + ".tmp.npz")
    np.savez_compressed(
        tmp, ver=np.array(VER), files=np.asarray(files, dtype=str),
        sizes=np.asarray(sizes, dtype=np.int64), mtimes=np.asarray(mtimes, dtype=np.int64),
        L=np.asarray(Ls, dtype=np.float32).reshape((-1, 2, 21, 3)),
        n=np.asarray(ns, dtype=np.int8), cls=np.asarray(cls, dtype=str),
        grp=np.asarray(groups, dtype=str), class_names=np.asarray(class_names, dtype=str),
    )
    tmp.replace(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--data", required=True, help="Folder berisi subfolder per kelas")
    ap.add_argument("--out", default="landmarks.npz")
    ap.add_argument("--max-side", type=int, default=1024)
    ap.add_argument("--block-size", type=int, default=30, help="Jumlah nomor foto per grup; sesuaikan dengan pola dataset")
    ap.add_argument("--save-every", type=int, default=500)
    a = ap.parse_args()
    if a.max_side < 64 or a.block_size < 1 or a.save_every < 1:
        ap.error("--max-side minimal 64; --block-size dan --save-every harus >= 1")

    root = Path(a.data).expanduser().resolve()
    if not root.is_dir():
        raise SystemExit(f"Folder dataset tidak ditemukan: {root}")
    class_dirs = sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))
    if not class_dirs:
        raise SystemExit(f"Tidak ada subfolder kelas di: {root}")
    class_names = [p.name for p in class_dirs]
    all_images = [(c.name, p) for c in class_dirs for p in sorted(c.rglob("*")) if p.is_file() and p.suffix.lower() in EXT]
    first_number = {}
    for c in class_names:
        nums = [numeric_id(p) for label, p in all_images if label == c]
        nums = [x for x in nums if x is not None]
        first_number[c] = min(nums) if nums else None
    if not all_images:
        raise SystemExit("Tidak ada gambar JPG/JPEG/PNG/BMP/WEBP di folder kelas.")
    no_numeric = [c for c, first in first_number.items() if first is None]
    if no_numeric:
        print("PERINGATAN: nama file kelas berikut tidak berakhir dengan nomor; tiap nama file akan menjadi grup sendiri:", ", ".join(no_numeric))

    out = Path(a.out).resolve()
    cache = {}
    if out.exists():
        try:
            with np.load(out, allow_pickle=False) as z:
                if "ver" in z.files and int(z["ver"]) == VER:
                    for i, rel in enumerate(z["files"]):
                        cache[str(rel)] = (int(z["sizes"][i]), int(z["mtimes"][i]), z["L"][i].copy(), int(z["n"][i]), str(z["grp"][i]))
                    print(f"Resume: {len(cache)} rekaman tersimpan (akan diverifikasi fingerprint file).")
                else:
                    print("Format NPZ lama/tidak dikenal: ekstraksi ulang dilakukan.")
        except Exception as e:
            print(f"Cache tidak dapat dibaca ({e}); ekstraksi ulang dilakukan.")

    import mediapipe as mp
    from PIL import Image, ImageOps
    from mediapipe.tasks import python as mpp
    from mediapipe.tasks.python import vision

    task = Path(__file__).resolve().parent / "hand_landmarker.task"
    if not task.exists():
        print("Mengunduh model tangan MediaPipe...")
        urllib.request.urlretrieve(URL, task)
    options = vision.HandLandmarkerOptions(
        base_options=mpp.BaseOptions(model_asset_path=str(task)), num_hands=2,
        min_hand_detection_confidence=0.3, min_hand_presence_confidence=0.3,
    )

    files, sizes, mtimes, Ls, ns, cls, groups = [], [], [], [], [], [], []
    failed = {}
    t0 = time.time()
    with vision.HandLandmarker.create_from_options(options) as det:
        for k, (c, p) in enumerate(all_images, 1):
            rel = p.relative_to(root).as_posix()
            st = p.stat()
            size, mtime = st.st_size, st.st_mtime_ns
            group = group_for(p, c, a.block_size, first_number[c])
            old = cache.get(rel)
            if old and old[0] == size and old[1] == mtime and old[4] == group:
                L, n = old[2], old[3]
            else:
                try:
                    with Image.open(p) as source:
                        im = ImageOps.exif_transpose(source).convert("RGB")
                    im.thumbnail((a.max_side, a.max_side))
                    result = det.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=np.asarray(im)))
                    L = np.zeros((2, 21, 3), dtype=np.float32)
                    n = min(len(result.hand_landmarks), 2)
                    for i in range(n):
                        L[i] = [[q.x * im.width, q.y * im.height, q.z * im.width] for q in result.hand_landmarks[i]]
                except Exception as e:
                    failed.setdefault(c, []).append(f"{rel}: {e}")
                    continue
            files.append(rel); sizes.append(size); mtimes.append(mtime)
            Ls.append(L); ns.append(n); cls.append(c); groups.append(group)
            if k % 100 == 0 or k == len(all_images):
                print(f"{k}/{len(all_images)} gambar | {time.time()-t0:.0f}s | {c}", flush=True)
            if k % a.save_every == 0:
                save(out, files, sizes, mtimes, Ls, ns, cls, groups, class_names)
    save(out, files, sizes, mtimes, Ls, ns, cls, groups, class_names)

    n_arr = np.asarray(ns); c_arr = np.asarray(cls)
    print(f"\nSelesai: {len(files)}/{len(all_images)} gambar tersimpan -> {out}")
    print(f"Grup: blok nomor foto {a.block_size} dihitung dari nomor terkecil tiap kelas; ini asumsi, bukan bukti sesi asli.")
    for c in class_names:
        mask = c_arr == c
        total = int(mask.sum())
        no_hand = int((n_arr[mask] == 0).sum()) if total else 0
        groups_count = len(set(np.asarray(groups)[mask])) if total else 0
        print(f"{c:16s} total={total:5d} tanpa_tangan={no_hand:5d} ({no_hand/total:.1%}) grup={groups_count}" if total else f"{c:16s} TOTAL=0 (tidak ada gambar berhasil diproses)")
    if failed:
        print("\nGambar gagal dibaca:", {c: len(v) for c, v in failed.items()})
        print("Contoh:", next(iter(next(iter(failed.values()))), ""))


if __name__ == "__main__":
    main()
